SURGESHIELD_API_KEY=surgeshield-demo
SURGESHIELD_SECRET=change-me-before-any-real-deployment
# Local demo uses 8010 because port 8000 is often already taken. Compose publishes 8000.
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_API_KEY=surgeshield-demo
# Optional. The copilot uses a template when these are empty, and it never decides.
SURGESHIELD_LLM_KEY=
SURGESHIELD_LLM_BASE=https://api.openai.com/v1
SURGESHIELD_LLM_MODEL=gpt-4o-mini
